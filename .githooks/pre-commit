#!/usr/bin/env sh
# Blocks a commit that stages anything gitleaks recognises as a credential.
# Scans only staged changes, so it stays fast enough to run on every commit.
set -eu

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed." >&2
  echo "            run: mise install" >&2
  exit 1
fi

root=$(git rev-parse --show-toplevel)
cd "$root"

# Throwaway config: tracked rules plus your local ones (see scan-config.sh).
. .githooks/scan-config.sh
tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT
build_scan_config "$tmp"

# -v names the file, rule and commit on a finding; --redact keeps the value masked.
gitleaks git --staged --redact --no-banner -v -c "$tmp"

# Page properties the Obsidian view reads (repo/obsidian-view.md). Checks the
# working tree, so an unstaged fix also counts; CI checks the committed tree.
python3 -I .githooks/check-properties.py
