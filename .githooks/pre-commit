#!/usr/bin/env sh
# Blocks a commit that stages anything gitleaks recognises as a credential.
# Scans only staged changes, so it stays fast enough to run on every commit.
set -eu

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed." >&2
  echo "            run: mise install" >&2
  exit 1
fi

root=$(git rev-parse --show-toplevel)
cd "$root"

# gitleaks exempts the exact path it is handed as -c from being scanned, so the
# rules file would be the one file no scan can see. Every scan therefore gets a
# throwaway copy as its config, which makes secret-scan.toml an ordinary target.
# (The file is also not named .gitleaks.toml: the built-in default config
# excludes every path matching gitleaks\.toml.)
tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT
cp secret-scan.toml "$tmp"

# -v names the file, rule and commit on a finding; --redact keeps the value masked.
gitleaks git --staged --redact --no-banner -v -c "$tmp"
