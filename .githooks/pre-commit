#!/usr/bin/env sh
# Blocks a commit that stages anything gitleaks recognises as a credential.
# Scans only staged changes, so it stays fast enough to run on every commit.
set -eu

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed." >&2
  echo "            run: mise install" >&2
  exit 1
fi

root=$(git rev-parse --show-toplevel)
cd "$root"
conf="$root/secret-scan.toml"

gitleaks git --staged --redact --no-banner -c "$conf"

# gitleaks never scans the file it was handed as its own config, and its default
# allowlist additionally exempts any path matching "gitleaks.toml" — which is
# why the rules file is named secret-scan.toml. That still leaves the rules file
# itself unscanned by the pass above, so it gets a second pass with a throwaway
# copy as the config.
tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT
cp "$conf" "$tmp"
gitleaks dir "$conf" --redact --no-banner -c "$tmp"
