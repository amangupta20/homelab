#!/usr/bin/env sh
# Blocks a push that carries a credential in any commit being pushed.
# A commit already made with --no-verify still cannot leave the machine.
#
# Reads the refs git hands a pre-push hook on stdin:
#   <local ref> <local sha> <remote ref> <remote sha>
set -eu

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-push: gitleaks is not installed." >&2
  echo "          run: mise install" >&2
  exit 1
fi

root=$(git rev-parse --show-toplevel)
cd "$root"

# Same rules-file problem as pre-commit: hand gitleaks a throwaway copy so
# secret-scan.toml is scanned like any other file.
tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT
cp secret-scan.toml "$tmp"

zero=0000000000000000000000000000000000000000
status=0

while read -r local_ref local_sha _remote_ref remote_sha; do
  # Deleting a remote branch pushes no content.
  [ "$local_sha" = "$zero" ] && continue

  # Fail closed: gitleaks exits 0 when git cannot resolve a revision, so a range
  # this clone does not understand must never be mistaken for a clean scan.
  if ! git rev-parse --verify --quiet "$local_sha^{commit}" >/dev/null; then
    echo "pre-push: cannot resolve $local_sha for $local_ref; refusing to push unscanned." >&2
    status=1
    continue
  fi

  # Scan only the commits this ref actually carries. A bare `gitleaks git` walks
  # --all and would block a clean push because of an unrelated local branch.
  # If the remote tip is absent locally (not fetched yet, e.g. before a
  # force-push), scan the pushed ref's own history rather than a range git
  # cannot resolve.
  if [ "$remote_sha" != "$zero" ] && git rev-parse --verify --quiet "$remote_sha^{commit}" >/dev/null; then
    echo "pre-push: scanning $local_ref ($remote_sha..$local_sha)"
    gitleaks git --redact --no-banner -v -c "$tmp" --log-opts "$remote_sha..$local_sha" || status=1
  else
    echo "pre-push: scanning the full history of $local_ref"
    gitleaks git --redact --no-banner -v -c "$tmp" --log-opts "$local_sha" || status=1
  fi
done

if [ "$status" -ne 0 ]; then
  echo "" >&2
  echo "pre-push: secret found in a commit being pushed. Nothing was sent." >&2
  echo "          Rotate the credential first, then rewrite the commit." >&2
  echo "          See docs/secret-scanning.md" >&2
fi

exit "$status"
