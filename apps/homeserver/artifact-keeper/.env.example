# Placeholders for `docker compose config` in CI. On cache-1, ansible/cache.yml
# writes the real .env from OpenBao: the zone from kv/general/cloudflare, the
# rest from kv/homelab/artifact-keeper. None of them is a secret; the client
# secrets are files (compose.yaml, "secrets").
LAB_ZONE=example.org
AUTHENTIK_DOMAIN=auth.example.org
AK_OIDC_CLIENT_ID=__PASTE_ONCE__
