# Placeholders for `docker compose config` in CI. On proxy-1, ansible/proxy.yml
# writes the real .env from OpenBao: Authentik's public address, kv/general/authentik
# field domain (not a secret; the outpost's token is a file, compose.yaml "secrets").
AUTHENTIK_HOST=https://auth.example.org
# The token between traefik-log-dashboard's agent and its dashboard, kv/homelab/traefik-log-dashboard field
# token. A secret on proxy-1, so ansible/proxy.yml writes .env with mode 0600.
LOG_AGENT_TOKEN=__PASTE_ONCE__

# Resolvr's seed accounts (admin, viewer). Nobody signs in with them: passing Authentik is the sign-in
# (NOTES.md, "Resolvr"). OpenBao kv/homelab/resolvr, field seed_password.
RESOLVR_SEED_PASSWORD=__PASTE_ONCE__
