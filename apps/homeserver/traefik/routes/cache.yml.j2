# cache-1: Artifact Keeper's web UI, through the
# cache's own Caddy on port 80 (apps/homeserver/artifact-keeper/Caddyfile).
# apt and Docker clients keep using http://10.22.33.137 directly.
http:
  routers:
    cache:
      rule: "Host(`cache.home.{{ lab_zone }}`)"
      entryPoints: [websecure]
      service: cache
  services:
    cache:
      loadBalancer:
        servers:
          - url: "http://10.22.33.137:80"
