# Traefik's own dashboard, behind Authentik's forward-auth (members of homelab-admins only; Authentik
# application `traefik-home`). Rendered by ansible/proxy.yml with the zone from OpenBao.
http:
  routers:
    dashboard:
      rule: "Host(`traefik.home.{{ lab_zone }}`)"
      entryPoints: [websecure]
      middlewares: [authentik]
      # Traefik's internal service for the dashboard and its API (api.dashboard in traefik.yml).
      service: api@internal
    # The outpost's own paths on this hostname: the sign-in callback and sign-out. Not behind forward-auth,
    # since they are how a session starts.
    dashboard-outpost:
      rule: "Host(`traefik.home.{{ lab_zone }}`) && PathPrefix(`/outpost.goauthentik.io/`)"
      priority: 100
      entryPoints: [websecure]
      service: authentik-outpost
  middlewares:
    # Without an Authentik session the outpost answers with a redirect to Authentik's sign-in; if the outpost
    # cannot be reached, Traefik answers with an error and does not pass the request on.
    authentik:
      forwardAuth:
        address: "http://authentik-outpost:9000/outpost.goauthentik.io/auth/traefik"
        # Drop every X-Forwarded-* header the client sent; Traefik then sets its own (method, proto, port, host,
        # URI) for the outpost. Unset, Traefik 3.7 drops only some of them and warns (pkg/middlewares/auth/forward.go).
        trustForwardHeader: false
        # The largest answer Traefik takes from the outpost (1 MiB); its sign-in redirects are a few hundred bytes.
        # Unset, Traefik 3.7 reads any size and warns.
        maxResponseBodySize: 1048576
        authResponseHeaders:
          - X-authentik-username
          - X-authentik-groups
          - X-authentik-email
  services:
    authentik-outpost:
      loadBalancer:
        servers:
          - url: "http://authentik-outpost:9000"
