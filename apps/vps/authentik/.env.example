# Every variable the stack reads. The real values live in OpenBao at kv/dokploy/authentik and reach
# the stack through the Dokploy service environment. The compose file stops the deploy if one is unset.

# The public login domain, auth.<zone> for example. Field domain
AUTHENTIK_DOMAIN=auth.example.com
# The tailnet-only hostname for the admin interface, with a DNS-only record to the VPS's tailnet
# address. Field admin_host
AUTHENTIK_ADMIN_HOST=auth-admin.example.com
# The zone the wildcard certificate covers. Field zone
ZONE=example.com
# 60 random characters or more (`openssl rand -base64 60 | tr -d '\n'`). Changing it later logs
# everyone out. Field secret_key
AUTHENTIK_SECRET_KEY=__PASTE_ONCE__
# The `authentik` role's password on pigsty-1. The same value is in kv/general/pigsty, field
# pg_user_authentik, which render.sh reads. Field pg_password
AUTHENTIK_PG_PASSWORD=__PASTE_ONCE__
