# Every variable the stack reads. The real values live in OpenBao at kv/dokploy/blinko and reach
# the stack through the Dokploy service environment. The compose file stops the deploy if one is unset.

# The public domain, also set in Dokploy. Field domain
BLINKO_DOMAIN=__PASTE_ONCE__
# Field nextauth_secret
BLINKO_NEXTAUTH_SECRET=__PASTE_ONCE__
# postgresql://blinko:<password>@<pigsty-1 tailnet address>:5433/blinko. Field database_url
BLINKO_DATABASE_URL=__PASTE_ONCE__
