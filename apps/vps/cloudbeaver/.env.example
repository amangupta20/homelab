# Every variable the stack reads. The real values live in OpenBao at kv/dokploy/cloudbeaver and reach
# the stack through the Dokploy service environment. The compose file stops the deploy if one is unset.

# CloudBeaver's own admin account, created on the first start. Field admin_name
CLOUDBEAVER_ADMIN_NAME=__PASTE_ONCE__
# Field admin_password
CLOUDBEAVER_ADMIN_PASSWORD=__PASTE_ONCE__
# Its hostname, cloudbeaver.<zone>, with a DNS-only record to the VPS's tailnet address. Field host
CLOUDBEAVER_HOST=cloudbeaver.example.com
# The zone the wildcard certificate covers. Field zone
ZONE=example.com
