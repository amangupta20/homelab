# Every variable the stack reads. Real values live in OpenBao and reach the
# stack through the Dokploy service environment — never this repo. Both are
# required: the compose file stops the deploy if either is unset.

# WebUI login password. OpenBao: kv/homelab/hermes-webui/password
HERMES_WEBUI_PASSWORD=__PASTE_ONCE__

# Key the WebUI uses to talk to the agent's gateway, any long random string.
# OpenBao: kv/homelab/hermes-webui/api-server-key
API_SERVER_KEY=__PASTE_ONCE__
