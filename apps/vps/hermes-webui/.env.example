# Every variable the stack reads. The real value lives in OpenBao and reaches
# the stack through the Dokploy service environment — never this repo. The
# compose file stops the deploy if it is unset.

# WebUI login password. OpenBao: kv/dokploy/hermes-webui, field password
HERMES_WEBUI_PASSWORD=__PASTE_ONCE__

# Authentik's public login domain (auth.app.<zone>). OpenBao: same path, field authentik_domain
AUTHENTIK_DOMAIN=auth.example.com
# This app's public domain, for the OIDC redirect URI. Field domain
HERMES_WEBUI_DOMAIN=chat.example.com
# The Authentik OAuth2 provider of the application with slug `hermes-webui-1`.
# Fields oidc_client_id, oidc_client_secret
HERMES_WEBUI_OIDC_CLIENT_ID=__PASTE_ONCE__
HERMES_WEBUI_OIDC_CLIENT_SECRET=__PASTE_ONCE__
