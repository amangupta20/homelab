# The one variable set outside the compose file. The value lives in the
# Dokploy service environment (or OpenBao, once step 3 of
# plans/vps-foundations.md lands) — never in this repo. `__PASTE_ONCE__`
# doubles as the compose default so `docker compose config` passes in CI
# with no env file; Dokploy MUST override it with the real password.

# WebUI login password. Required: this app has a public domain, and upstream
# leaves auth off only for localhost use. Pick a long one — browsers remember it.
HERMES_WEBUI_PASSWORD=__PASTE_ONCE__
