# Every variable the hermes-webui stack reads. Values live in the Dokploy
# service environment (or OpenBao, once step 3 of plans/vps-foundations.md
# — "Wire secrets into deploys" — lands) — never in this repo. Placeholders keep their shape so
# `docker compose config` passes: __PASTE_ONCE__ where any text fits, and a
# same-shape dummy where Compose type-checks the value (ports, IPs).

# WebUI login password. Required: this app has a public domain, and upstream
# leaves auth off only for localhost use. Pick a long one — browsers remember it.
HERMES_WEBUI_PASSWORD=__PASTE_ONCE__
