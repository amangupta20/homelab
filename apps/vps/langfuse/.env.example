# Every variable the stack reads. The real values live in OpenBao at kv/dokploy/langfuse and reach
# the stack through the Dokploy service environment. The compose file stops the deploy if one is unset.

# The public domain, langfuse.<zone> for example. Field domain
LANGFUSE_DOMAIN=langfuse.example.com
# Authentik's public login domain, the same value as kv/dokploy/authentik, field domain. Field authentik_domain
AUTHENTIK_DOMAIN=auth.example.com
# The client ID and secret of the Authentik OAuth2 provider for the application with slug `langfuse`.
# Fields oidc_client_id, oidc_client_secret
LANGFUSE_OIDC_CLIENT_ID=__PASTE_ONCE__
LANGFUSE_OIDC_CLIENT_SECRET=__PASTE_ONCE__
# Session signing secret (`openssl rand -base64 32`). Changing it logs everyone out. Field nextauth_secret
LANGFUSE_NEXTAUTH_SECRET=__PASTE_ONCE__
# Salt for hashing API keys (`openssl rand -base64 32`). Changing it breaks every API key. Field salt
LANGFUSE_SALT=__PASTE_ONCE__
# 64 hex characters (`openssl rand -hex 32`), encrypts stored secrets such as model API keys. Field encryption_key
LANGFUSE_ENCRYPTION_KEY=__PASTE_ONCE__
# The `langfuse` role's password on pigsty-1. The same value is in kv/general/pigsty, field
# pg_user_langfuse, which render.sh reads. Letters and digits only: it goes into a URL. Field pg_password
LANGFUSE_PG_PASSWORD=__PASTE_ONCE__
# ClickHouse's `langfuse` user, inside the stack only (`openssl rand -hex 24`). Field clickhouse_password
LANGFUSE_CLICKHOUSE_PASSWORD=__PASTE_ONCE__
# Redis's password, inside the stack only (`openssl rand -hex 24`). Field redis_password
LANGFUSE_REDIS_PASSWORD=__PASTE_ONCE__
# The private B2 bucket and its S3 endpoint and region, from the bucket's page in B2.
# Fields s3_bucket, s3_endpoint, s3_region
LANGFUSE_S3_BUCKET=langfuse-example
LANGFUSE_S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
LANGFUSE_S3_REGION=us-west-004
# A B2 application key for that bucket only, read and write. Fields s3_access_key_id, s3_secret_access_key
LANGFUSE_S3_ACCESS_KEY_ID=__PASTE_ONCE__
LANGFUSE_S3_SECRET_ACCESS_KEY=__PASTE_ONCE__
