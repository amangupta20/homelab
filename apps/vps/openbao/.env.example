# The only variable: the VPS's Tailscale address, set in the Dokploy
# service's environment. It is not a secret, but it identifies the tailnet,
# so it stays out of this public repo (apps/README.md). The value below is a
# placeholder from Tailscale's range: `docker compose config` rejects text
# such as __PASTE_ONCE__ where an IP address belongs.
TAILSCALE_IP=100.64.0.1
