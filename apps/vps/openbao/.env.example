# Neither value is a secret: both are machine-specific and go in the Dokploy
# service's environment. OpenBao cannot hold its own settings.

# The VPS's Tailscale address (inventory/network.md). The value below is a
# placeholder from Tailscale's range: `docker compose config` rejects text
# such as __PASTE_ONCE__ where an IP address belongs.
TAILSCALE_IP=100.64.0.1

# Folder on the VPS holding tls.crt and tls.key (README.md, "TLS").
BAO_TLS_DIR=/etc/openbao/tls
