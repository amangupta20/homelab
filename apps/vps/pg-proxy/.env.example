# Every variable the stack reads. The real value lives in OpenBao at kv/dokploy/pg-proxy and reaches
# the stack through the Dokploy service environment. The compose file stops the deploy if it is unset.

# pigsty-1's tailnet IPv4 address (`tailscale ip -4 pigsty-1`). Field pigsty_1_address
PIGSTY_1_ADDRESS=100.64.0.1
