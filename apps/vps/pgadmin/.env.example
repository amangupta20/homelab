# Every variable the stack reads. The real values live in OpenBao at kv/dokploy/pgadmin and reach
# the stack through the Dokploy service environment. The compose file stops the deploy if one is unset.

# pgAdmin's own login. Field email
PGADMIN_EMAIL=owner@example.com
# Field password
PGADMIN_PASSWORD=__PASTE_ONCE__
# Its hostname, pgadmin.<zone>, with a DNS-only record to the VPS's tailnet address. Field host
PGADMIN_HOST=pgadmin.example.com
# The zone the wildcard certificate covers. Field zone
ZONE=example.com
