# Every variable the stack reads. The real values live in OpenBao at kv/dokploy/technitium
# and reach the stack through the Dokploy service environment. The compose file stops the
# deploy if one is unset.

# The VPS's own tailnet IPv4 address (`tailscale ip -4` on the VPS). Field vps_tailnet_address
VPS_TAILNET_ADDRESS=100.64.0.1

# The admin password for the first start; a copy of kv/homelab/technitium's. Field admin_password
TECHNITIUM_ADMIN_PASSWORD=__PASTE_ONCE__
