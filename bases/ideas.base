filters:
  and:
    - file.inFolder("ideas")
    - type == "idea"
views:
  - type: table
    name: Ideas Overview
    order:
      - file.name
      - status
      - verified
      - tags
    sort:
      - property: file.name
        direction: ASC
  - type: kanban
    name: Idea Status Kanban
    groupBy:
      property: status
      direction: ASC
