filters:
  and:
    - file.inFolder("inventory")

views:
  - type: table
    name: "Inventory Overview"
    order:
      - file.name
      - type
      - status
      - verified
      - hosts
      - tags
    sort:
      - property: file.name
        direction: ASC

  - type: list
    name: "Inventory List"
    order:
      - file.name
      - status
      - verified
