# Copy to secret-scan.local.toml (git-ignored) and replace the example domain.
# The hooks append this file to secret-scan.toml, so it may contain only
# [[rules]] blocks — no [extend] or [[allowlists]] at the top level.
#
# One rule per domain you own. Escape the dots: an unescaped `.` matches any
# character, and a pattern written with `\.` cannot match its own source text.

[[rules]]
id = "own-domain"
description = "A domain this lab serves"
regex = '''(?i)\bmy-lab-domain\.example\b'''
tags = ["network", "public-repo"]
